---
import Layout from '../layouts/Layout.astro';
import Editor from '../components/Editor.astro';
import RulePanel from '../components/RulePanel.astro';
import htmlhintPkg from 'htmlhint/package.json';

const year = new Date().getFullYear();
---

<Layout title="HTMLHint - The Static Code Analysis Tool you need for your HTML">
  <div class="container">
    <header class="masthead">
      <h1 class="h3">
        HTMLHint{' '}
        <span id="version" class="text-muted opacity-75 small">
          v{htmlhintPkg.version}
        </span>
      </h1>
    </header>

    <hr />

    <main>
      <Editor />

      <div id="stat-bar" class="bg-black bg-opacity-25">
        <span id="hint-state" role="status"></span>
        <div id="button-area">
          <button id="show-last" class="btn btn-sm btn-primary" type="button" title="Shift + F8">
            Previous
          </button>
          <button id="show-next" class="btn btn-sm btn-primary" type="button" title="F8">
            Next
          </button>
        </div>
      </div>

      <RulePanel />
    </main>

    <hr />

    <footer class="d-flex flex-wrap justify-content-between align-items-center gap-2 small opacity-75 mb-3">
      <p class="mb-0">&copy; HTMLHint {year}</p>
      <ul class="nav gap-3">
        <li class="nav-item">
          <a href="https://github.com/htmlhint/htmlhint-playground">GitHub</a>
        </li>
        <li class="nav-item">
          <a href="https://htmlhint.com/">htmlhint.com</a>
        </li>
      </ul>
    </footer>
  </div>
</Layout>

<script>
  import { initApp } from '../scripts/app.js';
  initApp();
</script>
